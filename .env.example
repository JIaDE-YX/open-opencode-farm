# OpenCode Farm environment template
# Copy to .env and adjust for your machine.

# Data directory (default: sibling directory named opencode-farm-data)
OPENCODE_FARM_DATA_DIR=/path/to/opencode-farm-data

# Service ports
OPENCODE_FARM_GATEWAY_PORT=8080
OPENCODE_FARM_EGRESS_PORT=2260

# Optional overrides for egress tokens (normally read from data/proxy/.tokens.txt)
# OPENCODE_FARM_PROXY_ADMIN_TOKEN=
# OPENCODE_FARM_PROXY_TOKEN=
